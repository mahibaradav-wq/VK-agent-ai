{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode gzip zstd
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
