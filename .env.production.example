# Публичный хостинг. Скопируйте в .env.production на VPS и заполните свои значения.
# Файл .env.production в git не коммитить.

SITE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
NEXT_PUBLIC_SITE_URL=https://example.com
AUTH_URL=https://example.com

# openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
TOKEN_ENCRYPTION_KEY=

POSTGRES_USER=polka
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=polka_social
DATABASE_URL=postgresql://polka:replace-with-a-strong-db-password@postgres:5432/polka_social

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/data/media

# На публичном сайте не задавайте AUTH_DEV_MAILBOX=true
# AUTH_DEV_MAILBOX=

# ADMIN_EMAILS=you@example.com
# EMAIL_API_KEY=
# EMAIL_API_URL=
# EMAIL_FROM=Polka Social <noreply@example.com>
