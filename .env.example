NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://polka:polka_dev_password@localhost:5432/polka_social
AUTH_SECRET=replace-with-a-long-random-string
AUTH_DEV_MAILBOX=true
# Локально/CI тесты открывают регистрацию. На личном проде после первого владельца не задавайте true:
# AUTH_ALLOW_PUBLIC_REGISTRATION=true
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/media
# Очередь. Без REDIS_URL используется inline-стенд (задача пишется в PostgreSQL).
# QUEUE_DRIVER=redis
# REDIS_URL=redis://127.0.0.1:6379
# Отдельный ключ шифрования токенов соцаккаунтов. В production обязателен.
# В development AUTH_SECRET остаётся резервным ключом для старых локальных записей.
# TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-string
# Первая интеграция — Telegram Bot API (токен от @BotFather, не пароль).
# AI. Предпочтительный путь — подключить ChatGPT в кабинете /app/ai.
# Env-ключ остаётся запасным стендом. Без ключа генерация не имитируется.
# Платные вызовы OpenAI выключены, пока оба флага не заданы. Лимит — общий на кабинет, не на проект.
# AI_LIVE_ENABLED=true
# AI_MONTHLY_HARD_LIMIT=50
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_IMAGE_MODEL=gpt-image-1.5
# Биллинг. В личном кабинете checkout ЮKassa из UI выключен; таблицы не удаляются.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Запасной стенд для тестов (не нужен, если задана ЮKassa):
# BILLING_WEBHOOK_SECRET=
# Подпись тестового webhook: заголовок x-billing-signature в формате t=timestamp,v1=hmac_sha256.
# Платформенная админка. Список email через запятую получает Superadmin при первом заходе в /admin.
# ADMIN_EMAILS=ops@example.test
# Почта уведомлений. Без EMAIL_API_KEY внешняя отправка не имитируется.
# EMAIL_API_KEY=
# EMAIL_API_URL=https://api.example.test/email
# EMAIL_FROM=Polka Social <noreply@example.test>
# S3 / MinIO
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=polka-media
# S3_ACCESS_KEY=polka
# S3_SECRET_KEY=polka_s3_password
# S3_FORCE_PATH_STYLE=true
