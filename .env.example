NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://polka:polka_dev_password@localhost:5432/polka_social
AUTH_SECRET=replace-with-a-long-random-string
AUTH_DEV_MAILBOX=true
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/media
# Очередь. Без REDIS_URL используется inline-стенд (задача пишется в PostgreSQL).
# QUEUE_DRIVER=redis
# REDIS_URL=redis://127.0.0.1:6379
# Шифрование токенов соцаккаунтов. Если пусто, используется AUTH_SECRET.
# TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-string
# Первая интеграция — Telegram Bot API (токен от @BotFather, не пароль).
# AI. Без ключа генерация не имитируется.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MONTHLY_LIMIT=50
# Биллинг. Без BILLING_WEBHOOK_SECRET checkout не имитирует оплату.
# BILLING_WEBHOOK_SECRET=
# Подпись webhook: заголовок x-billing-signature в формате t=timestamp,v1=hmac_sha256.
# Платформенная админка. Список email через запятую получает Superadmin при первом заходе в /admin.
# ADMIN_EMAILS=ops@example.test
# Почта уведомлений. Без EMAIL_API_KEY внешняя отправка не имитируется.
# EMAIL_API_KEY=
# EMAIL_API_URL=https://api.example.test/email
# EMAIL_FROM=Polka Social <noreply@example.test>
# S3 / MinIO
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=polka-media
# S3_ACCESS_KEY=polka
# S3_SECRET_KEY=polka_s3_password
# S3_FORCE_PATH_STYLE=true
